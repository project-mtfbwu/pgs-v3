NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only deployment gate. Enable only after the Supabase Google provider,
# client credentials, Site URL, and allowed callback URL are configured.
SUPABASE_GOOGLE_AUTH_ENABLED=false
# Server-only. Required only by the authenticated Premium purchase event boundary.
SUPABASE_SERVICE_ROLE_KEY=
PREMIUM_PURCHASE_WEBHOOK_SECRET=
# Server-only, independent random values of at least 32 characters.
AUTH_FLOW_SECRET=
RATE_LIMIT_HASH_SECRET=

# Explicit local/preview-only Admin/CMS fixture gate. Never use a production ref.
PGS_PREVIEW_FIXTURES=false
PGS_PREVIEW_PROJECT_REF=
PGS_PREVIEW_FIXTURE_PASSWORD=

# AI Analyst / Assistant V1 — server-only. Never expose to browser.
# If unset, AI features are disabled gracefully (core PGS continues to work).
OPENAI_API_KEY=
# Optional: override AI model. Allowlisted to known OpenAI json_object-capable models.
# Default: gpt-4o-mini
PGS_AI_MODEL=
